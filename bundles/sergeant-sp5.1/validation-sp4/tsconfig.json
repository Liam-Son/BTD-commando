{
  "compilerOptions": {
    "target":"ES2022",
    "module":"NodeNext",
    "moduleResolution":"NodeNext",
    "strict":true,
    "noEmit":false,
    "outDir":"dist",
    "rootDir":"src",
    "skipLibCheck":true,
    "exactOptionalPropertyTypes":true,
    "noUncheckedIndexedAccess":true,
    "noPropertyAccessFromIndexSignature":true
  },
  "include":["src/**/*.ts"]
}
