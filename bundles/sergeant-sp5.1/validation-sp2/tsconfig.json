{
  "compilerOptions": {
    "target":"ES2022",
    "module":"NodeNext",
    "moduleResolution":"NodeNext",
    "strict":true,
    "noEmit":false,
    "outDir":"dist",
    "rootDir":"src",
    "jsx":"preserve",
    "skipLibCheck":true,
    "baseUrl":".",
    "paths":{"@/*":["src/*"]},
    "exactOptionalPropertyTypes":true,
    "noUncheckedIndexedAccess":true,
    "noPropertyAccessFromIndexSignature":true
  },
  "include":["src/**/*.ts","src/**/*.tsx","src/**/*.d.ts"]
}
